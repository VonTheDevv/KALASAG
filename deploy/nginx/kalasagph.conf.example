# Install under nginx's http context (commonly /etc/nginx/conf.d/) and replace
# the domain, certificate paths, and document root before enabling it.

limit_req_zone $binary_remote_addr zone=kalasag_app_per_ip:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=kalasag_address_per_ip:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=kalasag_news_relay_per_ip:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=kalasag_connections_per_ip:10m;

map $http_origin $kalasag_address_origin_allowed {
    default 0;
    "" 1;
    "https://example.gov.ph" 1;
    "https://localhost" 1;
    "capacitor://localhost" 1;
}

server {
    listen 80;
    listen [::]:80;
    server_name example.gov.ph;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.gov.ph;

    root /var/www/kalasagph/dist;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/example.gov.ph/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.gov.ph/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:KalasagTLS:10m;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 1m;
    limit_conn kalasag_connections_per_ip 20;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), payment=(), usb=()" always;
    # A production AIS relay should be proxied from this host at /ais so CSP
    # remains origin-bound. Add a separate exact wss:// authority here only if
    # the relay is intentionally hosted elsewhere.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://*.googleusercontent.com https://*.supabase.co https://controlmap.mgb.gov.ph https://ulap-hazards.georisk.gov.ph; media-src 'self' blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co wss://$host; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" always;

    location / {
        limit_req zone=kalasag_app_per_ip burst=40 nodelay;
        try_files $uri $uri/ /index.html;
    }

    location = /api/address-search {
        if ($kalasag_address_origin_allowed = 0) { return 403; }
        if ($arg_q = "") { return 400; }

        limit_req zone=kalasag_address_per_ip burst=5 nodelay;
        limit_except GET { deny all; }

        proxy_pass https://photon.komoot.io/api;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name photon.komoot.io;
        proxy_set_header Host photon.komoot.io;
        proxy_set_header User-Agent "KALASAG/1.0 (address-autocomplete)";
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        expires -1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }

    # Authenticated server-to-server news source relay. Keep the Node service
    # on loopback and synchronize its secret with the Supabase Edge secrets.
    location = /internal/news-source {
        limit_req zone=kalasag_news_relay_per_ip burst=10 nodelay;
        limit_except GET HEAD { deny all; }

        proxy_pass http://127.0.0.1:8791;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Kalasag-News-Relay-Secret $http_x_kalasag_news_relay_secret;
        proxy_set_header If-None-Match $http_if_none_match;
        proxy_set_header If-Modified-Since $http_if_modified_since;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_connect_timeout 2s;
        proxy_read_timeout 15s;
        proxy_send_timeout 5s;
    }

    # Always-on AISStream relay. Run `npm run start:ais-relay` with the provider
    # key stored only in the server environment, then expose only this WSS path.
    location = /ais {
        proxy_pass http://127.0.0.1:8788/ais;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
    }

    location ~* ^/assets/.*\.(?:css|js|png|jpg|jpeg|webp|gif|svg|ico|woff2?)$ {
        try_files $uri =404;
        expires 1y;
    }

    location ~ /\.(?!well-known/) {
        deny all;
    }

    location ~* \.(?:map|env|sql|mjs|cjs|ts|tsx)$ {
        return 404;
    }
}
