{
  "name": "kalasagph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca node_modules/vite/bin/vite.js",
    "start:ais-relay": "node --use-system-ca server/ais-relay.mjs",
    "start:storm-relay": "node --use-system-ca server/storm-relay.mjs",
    "start:news-source-relay": "node --use-system-ca server/news-source-relay.mjs",
    "start:family-alert-worker": "node --use-system-ca server/family-alert-worker.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "release:check": "node --use-system-ca scripts/check-release-services.mjs",
    "services:check": "node --use-system-ca scripts/check-live-providers.mjs",
    "safe-grounds:check": "node --use-system-ca scripts/check-safe-ground-locations.mjs",
    "security:check": "node scripts/security-check.mjs",
    "security:audit": "npm audit --omit=dev",
    "urban-mask:build": "node scripts/build-urban-settlement-mask.mjs",
    "urban-mask:check": "node scripts/check-urban-settlement-mask.mjs",
    "urban-heat:check": "node scripts/check-urban-heat-logic.mjs",
    "emergency-contact:check": "node scripts/check-emergency-contact.mjs",
    "family-code:check": "node scripts/check-family-join-code-rotation.mjs",
    "family-alert:check": "node scripts/check-family-alert-delivery-hardening.mjs",
    "live-hazards:check": "node scripts/check-live-hazard-layers.mjs",
    "hazard-freshness:check": "node scripts/check-hazard-freshness.mjs",
    "news:check": "node scripts/check-news-feed.mjs",
    "news-relay:check": "node scripts/check-news-source-relay.mjs",
    "family-code:verify-live": "node scripts/verify-family-join-code-rotation.mjs",
    "storm-relay:check": "node scripts/check-storm-relay.mjs",
    "verify": "npm run lint && npm run urban-mask:check && npm run urban-heat:check && npm run emergency-contact:check && npm run family-code:check && npm run family-alert:check && npm run live-hazards:check && npm run hazard-freshness:check && npm run news:check && npm run news-relay:check && npm run storm-relay:check && npm run build && npm run security:check"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/push-notifications": "8.1.2",
    "@radix-ui/react-select": "^2.3.5",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/leaflet": "^1.9.21",
    "animejs": "^4.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/animejs": "^3.1.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "geotiff": "^3.0.5",
    "oxlint": "^1.71.0",
    "pg": "^8.22.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
